digraph G {
  graph [bgcolor="#edf1f5", rankdir=LR, nodesep=0.3, ranksep=0.45, margin=0.18, pad=0.05]
  node [shape=box, style="filled", fillcolor="#ffffff", color="#d7dde1", penwidth=1, fontname="Arial", fontsize=12, fontcolor="#12202b", margin="0.17,0.11"]
  edge [color="#12202b", penwidth=1, arrowsize=0.68]
  queues [label="Vehicle queues\nwaiting time"]
  agents [label="Traffic-light agents\nshare lane state"]
  priority [label="Compare cumulative\nwaiting time"]
  safety [label="Apply minimum green\ntime constraint"]
  phase [label="Choose next\nsignal phase"]
  queues -> agents -> priority -> safety -> phase
  phase -> queues [label="  update", fontname="Arial", fontsize=9, color="#dc542e", fontcolor="#dc542e", constraint=false]
}
