digraph G {
  graph [bgcolor="#edf1f5", rankdir=LR, nodesep=0.28, ranksep=0.5, margin=0.18, pad=0.05]
  node [shape=box, style="filled", fillcolor="#ffffff", color="#d7dde1", penwidth=1, fontname="Arial", fontsize=13, fontcolor="#12202b", margin="0.18,0.12"]
  edge [color="#12202b", penwidth=1, arrowsize=0.7]
  video [label="Input video"]
  analysis [label="Agglomeration analysis\n(classification & measurement)"]
  distance [label="Distance extraction\n(OCR, correction)"]
  fusion [label="Result fusion"]
  output [label="Overlay & final video"]
  {rank=same; analysis; distance}
  video -> analysis
  video -> distance
  analysis -> fusion
  distance -> fusion
  fusion -> output
}
