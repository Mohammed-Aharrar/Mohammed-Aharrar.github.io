---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { languages, ui, profile, type Lang } from "../../data/site";

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang }, props: { lang } }));
}

interface Props { lang: Lang; }

const { lang } = Astro.props;
const t = ui[lang];

const pdfPath = lang === "fr"
  ? "/cv/CV_Mohammed_Aharrar_Soulali_FR.pdf"
  : "/cv/CV_Mohammed_Aharrar_Soulali_EN.pdf";
---

<BaseLayout lang={lang} title={`${t.cvTitle} | ${profile.name}`}>
  <section class="cv-page shell">
    <header class="cv-page-header">
      <div>
        <p class="kicker">{t.cvTitle}</p>
        <h1>{lang === "en" ? "CV" : "CV"}</h1>
      </div>

      <div class="cv-actions">
        <a class="cv-action" href={pdfPath} target="_blank" rel="noreferrer">{t.openPdf} ↗</a>
        <a class="cv-action" href={pdfPath} download>{t.downloadPdf} ↓</a>
      </div>
    </header>

    <div class="pdf-shell">
      <object
        class="pdf-object"
        data={`${pdfPath}#view=FitH`}
        type="application/pdf"
        aria-label={`${t.cvTitle} - ${profile.name}`}
      >
        <div class="pdf-fallback">
          <p>{t.pdfFallback}</p>
          <a class="plain-link" href={pdfPath} target="_blank" rel="noreferrer">{t.openPdf}</a>
        </div>
      </object>
    </div>
  </section>
</BaseLayout>
