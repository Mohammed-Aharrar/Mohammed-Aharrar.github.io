---
interface Props {
  src: string;
  alt: string;
  compact?: boolean;
}
const { src, alt, compact = false } = Astro.props;
const asset = (path: string) => `${import.meta.env.BASE_URL}${path.replace(/^\//, "")}`;
---
<div class:list={["org-logo", compact && "compact"]}>
  <img src={asset(src)} alt={alt} loading="lazy" />
</div>
