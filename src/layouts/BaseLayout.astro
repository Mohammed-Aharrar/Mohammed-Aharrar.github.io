---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import type { Lang } from "../data/site";

interface Props { lang:Lang; title?:string; description?:string; }
const {lang,title="Mohammed Aharrar Soulali",description="Portfolio of Mohammed Aharrar Soulali."}=Astro.props;
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <meta name="description" content={description} />

  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta
    property="og:image"
    content="https://mohammed-aharrar.github.io/images/OG-preview.png"
  />
  <meta
    property="og:url"
    content="https://mohammed-aharrar.github.io/fr/"
  />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta
    name="twitter:image"
    content="https://mohammed-aharrar.github.io/images/OG-preview.png"
  />

  <meta name="theme-color" content="#f7f8fa" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{title}</title>
</head>
<body>
  <Header lang={lang} />
  <main><slot /></main>
  <Footer lang={lang} />
</body>
</html>
